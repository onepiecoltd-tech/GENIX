# Copy file nay thanh  live.env  (file live.env da duoc .gitignore — KHONG day len GitHub)
TIKTOK_USER=@ten_kenh_cua_ban
ANTHROPIC_API_KEY=
# Usage goi Claude Pro (phu): can cai Claude Code va dang nhap (lenh `claude`). Bat/tat cung duoc bang nut trong game.
# 1 = uu tien usage, het usage/loi tu chuyen sang ANTHROPIC_API_KEY.  0 = chi dung API key.
AI_USE_USAGE=0
CLAUDE_CLI_MODEL=haiku
CLI_MIN_GAP=20
CLI_MAX_CALLS_PER_HOUR=120
# CLAUDE_CLI_PATH=C:\duong\dan\claude.exe   (chi can neu may khong tim thay lenh claude)
CLAUDE_MODEL=claude-haiku-5-5
AI_INTERVAL=10
AI_MAX_CALLS_PER_HOUR=360
# Tu cam bo sung (cach nhau dau phay):
BAD_WORDS=
